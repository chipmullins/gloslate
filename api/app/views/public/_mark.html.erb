<%# Gloslate "clean slate" mark: a slate with a check on a plum-night tile, amber sparkle + halo. inverted: glass tile, for night surfaces. Mirrors HouseMark in mobile/src/components/icons.tsx. %>
<% inv = local_assigns[:inverted]; small = size.to_i < 56; id = "gm#{inv ? 'g' : ''}#{small ? 's' : ''}" %>
<svg xmlns="http://www.w3.org/2000/svg" aria-hidden="true" width="<%= size %>" height="<%= size %>" viewBox="0 0 100 100"><defs><radialGradient id="<%= id %>Sky" cx="30%" cy="0%" r="110%"><stop offset="0" stop-color="#4A2C5A"/><stop offset="0.55" stop-color="#2A1A33"/><stop offset="1" stop-color="#140C18"/></radialGradient><radialGradient id="<%= id %>Halo"><stop offset="0" stop-color="#FFB547" stop-opacity="0.55"/><stop offset="1" stop-color="#FFB547" stop-opacity="0"/></radialGradient></defs><% if inv %><rect x="0.5" y="0.5" width="99" height="99" rx="22.5" fill="#FFFFFF" fill-opacity="0.05" stroke="#FFFFFF" stroke-opacity="0.12"/><% else %><rect width="100" height="100" rx="23" fill="url(#<%= id %>Sky)"/><rect x="0.5" y="0.5" width="99" height="99" rx="22.5" fill="none" stroke="#FFFFFF" stroke-opacity="0.08"/><% end %><% if small %><rect x="19" y="30" width="58" height="48" rx="9.5" fill="#140C18" stroke="#F3EEF5" stroke-width="4.5"/><path d="M34 53 L43 62 L61 43" fill="none" stroke="#F3EEF5" stroke-width="7" stroke-linecap="round" stroke-linejoin="round"/><path d="M74 14 Q75 28 89 29 Q75 30 74 44 Q73 30 59 29 Q73 28 74 14 Z" fill="#FFB547"/><% else %><rect x="20" y="30" width="56" height="46" rx="9" fill="#140C18" stroke="#F3EEF5" stroke-width="3.5"/><path d="M34 53 L43 62 L61 43" fill="none" stroke="#F3EEF5" stroke-width="5" stroke-linecap="round" stroke-linejoin="round"/><circle cx="74" cy="29" r="20" fill="url(#<%= id %>Halo)"/><path d="M74 16 Q75 28 87 29 Q75 30 74 42 Q73 30 61 29 Q73 28 74 16 Z" fill="#FFB547"/><% end %></svg>
