<% content_for :title, "#{@req.requester.first_name} is requesting #{money(@req.amount_cents)} · Gloslate" %>
<% content_for :theme, "#2A1A33" %>
<% content_for :body_class, "on-night" %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
  <meta property="og:title" content="<%= @req.requester.first_name %> is requesting <%= money(@req.amount_cents) %>">
  <meta property="og:description" content="Tap to see the breakdown & pay. Gloslate never holds your money.">
  <meta property="og:image" content="<%= @req.image_url %>">
  <meta property="og:image:width" content="1080"><meta property="og:image:height" content="1350">
  <meta name="twitter:card" content="summary_large_image">
<% end %>
<% content_for :styles do %>
<style>
  body.on-night { background: var(--night-edge) var(--night-sky) no-repeat; background-size: 100% 100vh; min-height: 100vh; color: var(--on-dark); }
  .wrap { max-width: 440px; margin: 0 auto; padding: max(20px, env(safe-area-inset-top)) 20px 28px; display: flex; flex-direction: column; gap: 18px; min-height: 100vh; }
  .top { display: flex; align-items: center; justify-content: space-between; color: var(--on-dark); }
  .brand { display: flex; align-items: center; gap: 8px; font-family: var(--display); font-weight: 700; font-size: 19px; letter-spacing: -0.02em; }
  .brand small { font-family: var(--label); font-weight: 500; font-size: 10px; letter-spacing: 0.1em; text-transform: uppercase; color: var(--on-dark-muted); margin-left: 2px; }
  .top > small { color: var(--on-dark-muted); font-weight: 600; font-size: 12px; }
  .ticket { background: #fff; border-radius: 22px 22px 0 0; padding: 24px 22px 22px; }
  .zig { display: block; width: 100%; height: 12px; margin-top: -1px; }
  .who { display: flex; align-items: center; gap: 10px; }
  .avatar { width: 40px; height: 40px; border-radius: 50%; background: var(--brand-tint); color: var(--brand); font-family: var(--display); font-weight: 700; display: grid; place-items: center; }
  .who b { display: block; font-family: var(--display); font-weight: 600; font-size: 16px; color: var(--ink); } .who span { font-size: 12px; color: var(--muted); }
  .amount { font-family: var(--num); font-variant-numeric: tabular-nums; font-weight: 700; color: var(--ink); font-size: clamp(40px, 13vw, 52px); letter-spacing: -0.03em; margin: 14px 0 12px; }
  .lines { color: var(--ink); border-top: 1px dashed #D8CBD4; padding-top: 14px; display: flex; flex-direction: column; gap: 9px; font-size: 14px; }
  .line { display: flex; justify-content: space-between; gap: 12px; } .line .money { white-space: nowrap; }
  .line.credit { color: var(--owed); font-weight: 700; }
  .line .of { display: block; margin-top: 2px; font-size: 12px; font-weight: 600; color: var(--muted); }
  .line.credit .of { color: var(--owed); opacity: .8; }
  .line.total { font-weight: 800; border-top: 1px solid var(--hairline); padding-top: 9px; }
  .updated { margin-top: 12px; background: #FBEBDD; color: var(--you-owe); border-radius: 12px; padding: 10px 12px; font-size: 13px; font-weight: 700; }
  .pay { display: flex; flex-direction: column; gap: 10px; }
  .primary { min-height: 56px; border-radius: 16px; border: 0; background: var(--glow); color: var(--on-glow); box-shadow: 0 0 22px var(--glow-halo); font-size: 16px; font-weight: 700; display: flex; align-items: center; justify-content: center; text-decoration: none; }
  .apps { display: grid; grid-template-columns: repeat(auto-fit, minmax(90px, 1fr)); gap: 8px; }
  .app { min-height: 48px; border-radius: 12px; border: 1px solid var(--glass-border); background: var(--glass); color: var(--on-dark); font-size: 14px; font-weight: 700; display: flex; align-items: center; justify-content: center; text-decoration: none; }
  .hint { font-size: 12px; color: var(--on-dark-muted); text-align: center; margin: 0; }
  .zelle { display: none; background: var(--glass); border: 1px solid var(--glass-border); color: var(--on-dark); border-radius: 14px; padding: 14px 16px; font-size: 14px; }
  .zelle.open { display: block; } .zelle code { font-family: var(--mono); font-size: 15px; }
  details.paid summary { list-style: none; text-align: center; color: var(--on-dark); font-weight: 700; font-size: 14px; text-decoration: underline; cursor: pointer; min-height: 44px; display: grid; place-items: center; }
  details.paid summary.paid-cta { text-decoration: none; min-height: 54px; border-radius: 16px; border: 1px solid var(--glass-border); background: var(--glass); font-size: 16px; font-weight: 700; margin-top: 4px; }
  details.paid[open] summary.paid-cta { border-color: transparent; }
  .nudge { background: #fff; color: var(--ink); border-radius: 16px; padding: 14px 16px; font-weight: 700; display: none; margin-top: 10px; }
  .nudge.show { display: block; animation: nudge .5s ease-out both; }
  @keyframes nudge { 0% { transform: translateY(8px); opacity: 0 } 100% { transform: none; opacity: 1 } }
  details.paid summary::-webkit-details-marker { display: none; }
  .paidform { background: #fff; color: var(--ink); border-radius: 18px; padding: 16px; display: flex; flex-direction: column; gap: 10px; }
  .paidform label { font-size: 12.5px; font-weight: 700; color: var(--muted); }
  .paidform input, .paidform select { min-height: 48px; border-radius: 12px; border: 1px solid var(--chip-border); padding: 0 14px; font: inherit; font-size: 16px; width: 100%; background: #fff; }
  .paidform button { min-height: 52px; border-radius: 14px; border: 0; background: var(--brand); color: #fff; font-weight: 800; font-size: 15px; }
  .done { background: #fff; color: var(--ink); border-radius: 18px; padding: 18px; text-align: center; font-weight: 700; }
  .spacer { flex: 1; }
  .promo { background: var(--glass); border: 1px solid var(--glass-border); border-radius: 16px; padding: 14px 16px; display: flex; align-items: center; gap: 12px; color: var(--on-dark); }
  .promo div { flex: 1; } .promo b { display: block; font-size: 13.5px; } .promo span { font-size: 12px; color: var(--on-dark-muted); }
  .promo a { min-height: 44px; padding: 0 14px; border-radius: 12px; background: var(--on-dark); color: var(--night-edge); font-weight: 700; font-size: 13px; text-decoration: none; display: flex; align-items: center; }
  .fine { font-size: 11.5px; color: var(--on-dark-muted); text-align: center; margin: 0; }
</style>
<% end %>
<main class="wrap">
  <div class="top">
    <span class="brand" aria-label="Gloslate by Glofly"><%= render "public/mark", size: 28, inverted: true %>gloslate <small>by Glofly</small></span>
    <small>tabitat.app</small>
  </div>

  <div>
    <section class="ticket" aria-labelledby="ask">
      <div class="who">
        <span class="avatar" aria-hidden="true"><%= @req.requester.first_name[0] %></span>
        <span><b id="ask"><%= @req.requester.first_name %> is requesting</b><span>from <%= @req.recipient.first_name %> · <%= @req.created_at.strftime("%b %-d, %Y") %></span></span>
      </div>
      <div class="amount"><%= money(@req.amount_cents) %></div>
      <div class="lines">
        <% @req.breakdown.each do |l| %>
          <div class="line<%= ' credit' if l['cents'].negative? %>">
            <span><%= l["description"] %>
              <% if l["total_cents"].to_i > 0 && l["total_cents"].to_i != l["cents"].to_i.abs %>
                <small class="of"><%= l["cents"].negative? ? "#{@req.recipient.first_name} paid" : "#{@req.requester.first_name} paid" %> <span class="money"><%= money(l["total_cents"]) %></span><%= " · split #{l['split_count']} ways" if l["split_count"].to_i > 1 %></small>
              <% end %>
            </span>
            <span class="money"><%= money(l["cents"]) %></span>
          </div>
        <% end %>
        <div class="line total"><span>You send <%= @req.requester.first_name %></span><span class="money"><%= money(@req.amount_cents) %></span></div>
      </div>
      <% if @current != @req.amount_cents %>
        <div class="updated" role="status"><%= @current.positive? ? "Updated: now #{money(@current)}" : "Updated: you're all settled now" %></div>
      <% end %>
    </section>
    <svg class="zig" aria-hidden="true" viewBox="0 0 350 12" preserveAspectRatio="none"><path d="M0 0H350V2<% 35.times do |i| %>L<%= 340 - (i * 10) %> <%= i.even? ? 12 : 2 %><% end %>L0 12Z" fill="#fff"/></svg>
  </div>

  <% if @marked %>
    <div class="done" role="status">Thanks! <%= @req.requester.first_name %> will confirm they got it.</div>
  <% elsif @pay_amount.positive? %>
    <div class="pay">
      <% if (primary = @links[:venmo] || @links[:cashapp]) %>
        <a class="primary" href="<%= primary[:app] %>" data-web="<%= primary[:web] %>">Pay <%= @req.requester.first_name %> <%= money(@pay_amount) %></a>
      <% end %>
      <% if @links.any? %>
        <div class="apps">
          <% if @links[:venmo] %><a class="app" href="<%= @links[:venmo][:app] %>" data-web="<%= @links[:venmo][:web] %>">Venmo</a><% end %>
          <% if @links[:cashapp] %><a class="app" href="<%= @links[:cashapp][:app] %>">Cash App</a><% end %>
          <% if @links[:zelle] %><button class="app" type="button" id="zelle-btn" aria-expanded="false" aria-controls="zelle">Zelle</button><% end %>
        </div>
        <p class="hint">Amount and memo copy over automatically</p>
      <% else %>
        <p class="hint"><%= @req.requester.first_name %> hasn't added a payment app yet — pay them however you usually do.</p>
      <% end %>
      <% if @links[:zelle] %>
        <div class="zelle" id="zelle" role="region" aria-label="Zelle details">
          Send <b class="money"><%= money(@pay_amount) %></b> to <code id="zelle-to"><%= @links[:zelle][:copy] %></code> in your bank app.
          <div style="margin-top:8px"><button class="app" type="button" id="zelle-copy" style="width:100%">Copy email/phone</button></div>
        </div>
      <% end %>
    </div>

    <div class="nudge" id="nudge" role="status">Sent it? One more step: tap below so <%= @req.requester.first_name %> knows it's on the way.</div>
    <details class="paid" id="paid">
      <summary class="paid-cta">I paid. Let <%= @req.requester.first_name %> know</summary>
      <form action="/r/<%= @req.token %>/paid" method="post" class="paidform">
        <label for="amount">Amount you sent</label>
        <input id="amount" name="amount" inputmode="decimal" value="<%= money(@pay_amount).delete('$,') %>" autocomplete="off">
        <label for="method">How</label>
        <select id="method" name="method">
          <option value="venmo">Venmo</option><option value="cashapp">Cash App</option><option value="zelle">Zelle</option><option value="cash">Cash</option><option value="other">Other</option>
        </select>
        <button type="submit">I paid</button>
      </form>
    </details>
    <details class="paid">
      <summary>Paid for some things too?</summary>
      <p style="margin:10px 0 0;line-height:1.5">Add what you covered in the Gloslate app (on <%= @req.requester.first_name %>'s balance, tap <b>I paid for some things too</b>). It's split between you two and this total updates by itself.</p>
    </details>
  <% end %>

  <div class="spacer"></div>
  <div class="promo">
    <div><b>Split bills without the math</b><span>Track who owes who with Gloslate</span></div>
    <a href="/">Get the app</a>
  </div>
  <p class="fine">Gloslate never holds or moves money. Payments are marked and confirmed by the people involved.</p>
</main>
<script>
  // Prefer the payment app; fall back to its website if it isn't installed.
  document.querySelectorAll('a[data-web]').forEach(function (a) {
    a.addEventListener('click', function () { var w = a.dataset.web; setTimeout(function () { if (!document.hidden) location.href = w; }, 1200); });
  });
  var zb = document.getElementById('zelle-btn');
  if (zb) zb.addEventListener('click', function () { var z = document.getElementById('zelle'); z.classList.toggle('open'); zb.setAttribute('aria-expanded', z.classList.contains('open')); });
  // After someone heads off to pay, bring them back to the "I paid" step.
  var paid = document.getElementById('paid'), nudge = document.getElementById('nudge'), went = false;
  function backFromPaying() {
    if (!went || !paid) return;
    paid.open = true; nudge && nudge.classList.add('show');
    paid.scrollIntoView({ behavior: 'smooth', block: 'center' });
  }
  document.querySelectorAll('.pay a.primary, .pay a.app, #zelle-copy').forEach(function (el) {
    el.addEventListener('click', function () { went = true; setTimeout(backFromPaying, 2500); });
  });
  document.addEventListener('visibilitychange', function () { if (!document.hidden) backFromPaying(); });
  var zc = document.getElementById('zelle-copy');
  if (zc) zc.addEventListener('click', function () { navigator.clipboard && navigator.clipboard.writeText(document.getElementById('zelle-to').textContent).then(function () { zc.textContent = 'Copied'; }); });
</script>
