<% content_for :title, "Accounts" %><% content_for :nav, "accounts" %>
<header class="c-head"><div class="grow"><h1 class="c-title">Accounts</h1><p class="c-sub"><%= number_with_delimiter(@total) %> <%= @total == 1 ? "person" : "people" %><%= " · contact details masked for your role" unless at_least?(:support) %></p></div></header>
<form class="search" action="<%= control_accounts_path %>" method="get" role="search">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#685A66" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M11 18a7 7 0 100-14 7 7 0 000 14zM21 21l-5-5"/></svg>
  <input type="search" name="q" value="<%= params[:q] %>" placeholder="Name, email, phone or account id" aria-label="Search accounts">
  <input type="hidden" name="filter" value="<%= @filter %>">
</form>
<nav class="chips" aria-label="Filter">
  <% Control::AccountsController::FILTERS.each do |key, label| %>
    <a href="<%= control_accounts_path(filter: key, q: params[:q].presence) %>" aria-current="<%= key == @filter %>"><%= label %></a>
  <% end %>
</nav>
<section class="c-card">
  <div class="list">
    <% @users.each do |u| %>
      <a class="rowlink" href="<%= control_account_path(u) %>">
        <span class="avatar"><%= u.first_name.to_s[0] || "?" %></span>
        <span class="grow"><span><%= [u.first_name.presence || "No name", u.last_name].compact.join(" ") %></span><span><%= [mask(u.phone), mask(u.email)].compact_blank.join(" · ").presence || "No email or phone (Apple/Google)" %> · joined <%= local_time(u.created_at, "%b %-d, %Y") %></span></span>
        <span class="muted small" style="min-width:80px;text-align:right"><%= ago(u.last_active_at) %></span>
        <% if u.deleted? %><span class="pill plain">Deleted</span><% elsif u.locked? %><span class="pill bad">Locked</span><% elsif u.created_at > 7.days.ago %><span class="pill">New</span><% else %><span class="pill good">Active</span><% end %>
      </a>
    <% end %>
    <% if @users.empty? %><p class="muted">Nobody matches.</p><% end %>
  </div>
</section>
<div class="pager">
  <% if @page > 1 %><a class="btn sm" href="<%= control_accounts_path(filter: @filter, q: params[:q].presence, page: @page - 1) %>">Newer</a><% end %>
  <% if @page * 40 < @total %><a class="btn sm" href="<%= control_accounts_path(filter: @filter, q: params[:q].presence, page: @page + 1) %>">Older</a><% end %>
</div>
