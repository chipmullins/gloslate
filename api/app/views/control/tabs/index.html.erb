<% content_for :title, "Tabs" %><% content_for :nav, "tabs" %>
<header class="c-head"><div class="grow"><h1 class="c-title">Tabs</h1><p class="c-sub"><%= number_with_delimiter(@total) %> homes, one-on-ones and groups. Read-only: staff can't change money.</p></div></header>
<form class="search" action="<%= control_tabs_path %>" method="get" role="search">
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#685A66" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M11 18a7 7 0 100-14 7 7 0 000 14zM21 21l-5-5"/></svg>
  <input type="search" name="q" value="<%= params[:q] %>" placeholder="Tab name, someone in it, or id" aria-label="Search tabs">
  <input type="hidden" name="kind" value="<%= params[:kind] %>">
</form>
<nav class="chips" aria-label="Kind">
  <a href="<%= control_tabs_path(q: params[:q].presence) %>" aria-current="<%= params[:kind].blank? %>">All</a>
  <a href="<%= control_tabs_path(kind: 'home', q: params[:q].presence) %>" aria-current="<%= params[:kind] == 'home' %>">Homes</a>
  <a href="<%= control_tabs_path(kind: 'group', q: params[:q].presence) %>" aria-current="<%= params[:kind] == 'group' %>">One-on-ones and groups</a>
</nav>
<section class="c-card">
  <div class="list">
    <% @tabs.each do |h| current = h.members.select { _1.left_at.nil? } %>
      <a class="rowlink" href="<%= control_tab_path(h) %>">
        <span class="grow"><span><%= h.name.presence || "Untitled" %></span><span><%= current.map(&:display_name).first(5).join(", ") %><%= " +#{current.size - 5}" if current.size > 5 %></span></span>
        <span class="pill <%= h.group? ? 'plain' : '' %>"><%= h.group? ? (current.size <= 2 ? "One-on-one" : "Group") : "Home" %></span>
        <span class="muted small" style="min-width:90px;text-align:right"><%= ago(h.updated_at) %></span>
      </a>
    <% end %>
    <% if @tabs.empty? %><p class="muted">No tabs match.</p><% end %>
  </div>
</section>
<div class="pager">
  <% if @page > 1 %><a class="btn sm" href="<%= control_tabs_path(kind: params[:kind], q: params[:q].presence, page: @page - 1) %>">Newer</a><% end %>
  <% if @page * 40 < @total %><a class="btn sm" href="<%= control_tabs_path(kind: params[:kind], q: params[:q].presence, page: @page + 1) %>">Older</a><% end %>
</div>
