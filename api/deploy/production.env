# Non-secret settings for gloslate.app (ships inside the app image).
DB_HOST=production-db
PUBLIC_URL=https://gloslate.app
ALLOWED_HOSTS=gloslate.app,api.gloslate.app,admin-api.gloslate.app,control.gloslate.app,app.gloslate.app,tabitat.app,api.tabitat.app,admin-api.tabitat.app,app.tabitat.app
# Gloslate Control (staff console, /control) answers only on these hosts.
CONTROL_HOSTS=admin-api.gloslate.app,control.gloslate.app,admin-api.tabitat.app
WEBAPP_HOSTS=app.gloslate.app,app.tabitat.app
MAIL_FROM=Gloslate <hello@tabitat.app>
SOLID_QUEUE_IN_PUMA=true
RAILS_MAX_THREADS=3
ACTIVE_STORAGE_SERVICE=amazon
MAIL_DELIVERY=ses
SMS_DELIVERY=sns
APPLE_CLIENT_IDS=app.tabitat
APPLE_TEAM_ID=4XK3F69URN
SUPPORT_EMAIL=support@gloslate.app
LEGAL_DRAFT=true
# Sign in with Glofly: Gloslate's public client ID (not secret). Empty = off.
GLOFLY_ISSUER=https://api.glofly.app
GLOFLY_CLIENT_IDS=gfa_2HbV4amyEL8I
GLOFLY_REDIRECT_URIS=tabitat://auth/glofly,https://app.gloslate.app/auth/glofly/callback
# Fill in as they arrive: GOOGLE_CLIENT_IDS, ANDROID_CERT_SHA256, APP_STORE_URL, PLAY_STORE_URL
