# Non-secret settings for tabitat.app (ships inside the app image).
DB_HOST=production-db
PUBLIC_URL=https://tabitat.app
ALLOWED_HOSTS=tabitat.app,api.tabitat.app,admin-api.tabitat.app
MAIL_FROM=Tabitat <hello@tabitat.app>
SOLID_QUEUE_IN_PUMA=true
RAILS_MAX_THREADS=3
ACTIVE_STORAGE_SERVICE=amazon
MAIL_DELIVERY=ses
SMS_DELIVERY=sns
APPLE_CLIENT_IDS=app.tabitat
APPLE_TEAM_ID=4XK3F69URN
SUPPORT_EMAIL=support@tabitat.app
LEGAL_DRAFT=true
