# HTTPS certificates come from Let's Encrypt automatically.
{
	email {$ACME_EMAIL}
}

# Gloslate's domain (live since Nov 6, 2026).
gloslate.app, api.gloslate.app, admin-api.gloslate.app, app.gloslate.app {
	encode zstd gzip
	reverse_proxy production-web:80
}

www.gloslate.app {
	redir https://gloslate.app{uri} permanent
}

staging.gloslate.app {
	encode zstd gzip
	reverse_proxy staging-web:80
}

# The original domain. Installed apps that predate the switch call
# api.tabitat.app, so the API keeps answering there. Everything people open
# in a browser moves to gloslate.app, path and all (old request and invite
# links keep working). App-link files stay on tabitat.app so old invite links
# can still open the app.
api.tabitat.app, admin-api.tabitat.app {
	encode zstd gzip
	reverse_proxy production-web:80
}

tabitat.app, www.tabitat.app {
	handle /.well-known/* {
		reverse_proxy production-web:80
	}
	handle {
		redir https://gloslate.app{uri} permanent
	}
}

app.tabitat.app {
	redir https://app.gloslate.app{uri} permanent
}

staging.tabitat.app {
	redir https://staging.gloslate.app{uri} permanent
}
