# Non-secret settings for staging.tabitat.app (ships inside the app image).
DB_HOST=staging-db
PUBLIC_URL=https://staging.tabitat.app
ALLOWED_HOSTS=staging.gloslate.app,staging.tabitat.app
# The web app runs only on production for now (app.tabitat.app).
WEBAPP_HOSTS=
MAIL_FROM=Gloslate Staging <hello@tabitat.app>
SOLID_QUEUE_IN_PUMA=true
RAILS_MAX_THREADS=3
ACTIVE_STORAGE_SERVICE=amazon
MAIL_DELIVERY=ses
SMS_DELIVERY=sns
APPLE_CLIENT_IDS=app.tabitat
APPLE_TEAM_ID=4XK3F69URN
SUPPORT_EMAIL=support@tabitat.app
LEGAL_DRAFT=true
# Fill in as they arrive: GOOGLE_CLIENT_IDS, ANDROID_CERT_SHA256, APP_STORE_URL, PLAY_STORE_URL
