{
  "expo": {
    "name": "HomeTab",
    "slug": "hometab",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "hometab",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.hometab",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:hometab.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1C6A4C",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.hometab",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "hometab.app",
              "pathPrefix": "/i/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1C6A4C",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#1C6A4C"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "HomeTab uses Face ID to lock the app so only you can see your balances."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "HomeTab uses the camera to scan receipts. The text is read on your phone.",
          "photosPermission": "HomeTab lets you attach a receipt photo from your library."
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "BalanceWidget",
              "displayName": "HomeTab balance",
              "description": "Who owes who, at a glance.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": ""
      }
    }
  }
}