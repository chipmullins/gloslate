{
  "expo": {
    "name": "Gloslate",
    "slug": "tabitat",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "tabitat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "app.tabitat",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:tabitat.app",
        "applinks:app.tabitat.app",
        "applinks:gloslate.app",
        "applinks:app.gloslate.app"
      ],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2A1A33",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.tabitat",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "tabitat.app",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "app.tabitat.app",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "gloslate.app",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "app.gloslate.app",
              "pathPrefix": "/i/"
            },
            {
              "scheme": "https",
              "host": "tabitat.app",
              "pathPrefix": "/f/"
            },
            {
              "scheme": "https",
              "host": "app.tabitat.app",
              "pathPrefix": "/f/"
            },
            {
              "scheme": "https",
              "host": "gloslate.app",
              "pathPrefix": "/f/"
            },
            {
              "scheme": "https",
              "host": "app.gloslate.app",
              "pathPrefix": "/f/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/with-no-script-sandboxing",
      "./plugins/with-app-shortcuts",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2A1A33",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-notifications",
        {
          "color": "#6B3A63"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Gloslate uses Face ID to lock the app so only you can see your balances."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Gloslate uses the camera to scan receipts. The text is read on your phone.",
          "photosPermission": "Gloslate lets you attach a receipt photo from your library."
        }
      ],
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "BalanceWidget",
              "displayName": "Gloslate balance",
              "description": "Who owes who, at a glance.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ],
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "both"
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "be830f45-fa72-4252-aac5-da99f10c91d5"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0,
      "requestHeaders": {
        "expo-channel-name": "production"
      },
      "url": "https://u.expo.dev/be830f45-fa72-4252-aac5-da99f10c91d5"
    },
    "owner": "chipmullins"
  }
}
