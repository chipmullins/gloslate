{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_API_URL": "https://api.tabitat.app" },
      "ios": { "resourceClass": "default" }
    },
    "staging": {
      "extends": "production",
      "env": { "EXPO_PUBLIC_API_URL": "https://staging.tabitat.app" }
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": { "EXPO_PUBLIC_API_URL": "https://staging.tabitat.app" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "6830983726", "appleTeamId": "4XK3F69URN" }
    },
    "staging": { "extends": "production" }
  }
}
